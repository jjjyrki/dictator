<resources>
    <style name="Theme.Dictator" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:colorAccent">@color/setup_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/setup_bg</item>
        <item name="android:navigationBarDividerColor">@color/setup_bg</item>
        <item name="android:statusBarColor">@color/setup_bg</item>
        <item name="android:textColor">@color/setup_text</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/setup_bg</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorPrimary">@color/setup_accent</item>
        <item name="colorOnPrimary">@color/setup_bg</item>
        <item name="colorPrimaryContainer">@color/setup_surface</item>
        <item name="colorOnPrimaryContainer">@color/setup_accent_soft</item>
        <item name="colorSecondary">@color/setup_button_tint</item>
        <item name="colorOnSecondary">@color/setup_text</item>
        <item name="colorSecondaryContainer">@color/setup_surface</item>
        <item name="colorOnSecondaryContainer">@color/setup_text</item>
        <item name="colorTertiary">@color/setup_accent_soft</item>
        <item name="colorOnTertiary">@color/setup_bg</item>
        <item name="colorSurface">@color/setup_surface</item>
        <item name="colorOnSurface">@color/setup_text</item>
        <item name="colorSurfaceVariant">@color/setup_inset</item>
        <item name="colorOnSurfaceVariant">@color/setup_muted</item>
        <item name="colorOutline">@color/setup_border</item>
        <item name="colorError">@color/setup_error</item>
        <item name="colorOnError">@color/setup_on_error</item>
        <item name="colorErrorContainer">@color/setup_error_container</item>
        <item name="colorOnErrorContainer">@color/setup_on_error_container</item>
    </style>
</resources>
