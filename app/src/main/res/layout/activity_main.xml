<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setup_title"
                android:textColor="@color/setup_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/modelMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/select_model"
                android:minHeight="48dp"
                android:text="@string/model_menu_button" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_body"
            android:textColor="@color/setup_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/selectedModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/setup_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/modelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/setup_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/installModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/install_model" />

        <Button
            android:id="@+id/record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/start_recording" />

        <TextView
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1AFFFFFF"
            android:minHeight="96dp"
            android:padding="12dp"
            android:textColor="@color/setup_text"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/sampleMetricsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sample_metrics_title"
            android:textColor="@color/setup_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sampleMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1AFFFFFF"
            android:padding="12dp"
            android:text="@string/sample_metrics_empty"
            android:textColor="@color/setup_muted"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/accessibilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textColor="@color/setup_warn"
            android:textSize="16sp" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/open_accessibility_settings" />

        <Button
            android:id="@+id/toggleInsertMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/toggle_insert_mode" />

        <Button
            android:id="@+id/togglePartials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/toggle_partials" />

        <Button
            android:id="@+id/toggleFinnish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/toggle_finnish" />
    </LinearLayout>
</ScrollView>
