<resources>
    <string name="app_name">Dictator</string>
    <string name="app_tagline">Private, on-device dictation</string>
    <string name="accessibility_service_label">Dictator dictation bubble</string>
    <string name="accessibility_service_description">Shows a microphone bubble over editable fields and inserts dictated text. Dictator uses accessibility access to find the focused field and insert your words. It does not replace the keyboard.</string>
    <string name="setup_title">Speak naturally. Type instantly.</string>
    <string name="setup_body">Dictator turns your voice into text without sending audio to the cloud. Download a speech model once, enable the dictation bubble, and use it anywhere you can type.</string>
    <string name="privacy_note">No account. No cloud transcription.</string>
    <string name="setup_step_model">1  CHOOSE A SPEECH MODEL</string>
    <string name="model_helper">Smaller models use less storage and respond faster. Larger models may be more accurate.</string>
    <string name="setup_step_accessibility">2  TURN ON THE DICTATION BUBBLE</string>
    <string name="accessibility_helper">Dictator needs accessibility access to find editable fields and insert the words you dictate. Your text is processed on this phone.</string>
    <string name="setup_step_test">3  TRY A SHORT DICTATION</string>
    <string name="test_helper">Record a sample here to check your microphone and transcription. Once the bubble is on, you can dictate in any app with a text field.</string>
    <string name="preferences_title">PREFERENCES</string>
    <string name="privacy_footer">Audio and transcripts stay on this device. The only network request is downloading the model you choose.</string>
    <string name="licenses_button">Open-source licenses</string>
    <string name="licenses_title">Open-source licenses</string>
    <string name="licenses_intro">Dictator uses open-source software and downloads speech models licensed by their authors. These notices are provided for attribution.</string>
